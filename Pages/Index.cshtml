@page
@model IndexModel
@{
    ViewData["Title"] = "School Management";
}
<div class="p-4 mb-4 bg-light rounded-3">
    <h1 class="display-5">School Management</h1>
    <p class="lead">Razor Pages database-first app for departments, instructors, courses, students, and enrollments.</p>
</div>
<div class="row g-3">
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Departments</h2><p>Manage academic departments and budgets.</p><a class="btn btn-primary" asp-page="/Departments/Index">Open Departments</a></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Courses</h2><p>Manage courses and their departments.</p><a class="btn btn-primary" asp-page="/Courses/Index">Open Courses</a></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Students</h2><p>Manage student records and enrollment dates.</p><a class="btn btn-primary" asp-page="/Students/Index">Open Students</a></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Instructors</h2><p>Manage instructor records.</p><a class="btn btn-primary" asp-page="/Instructors/Index">Open Instructors</a></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Enrollments</h2><p>Link students to courses and record grades.</p><a class="btn btn-primary" asp-page="/Enrollments/Index">Open Enrollments</a></div></div></div>
</div>
